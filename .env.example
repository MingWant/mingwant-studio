# 本文件只声明可公开的运行配置，不要在这里填写任何密钥。
# 全新 Compose 安装可在第一次启动前固定项目标识；已有数据必须沿用原值，否则会切换数据卷。
# COMPOSE_PROJECT_NAME=mingwant-studio
CANVAS_REGISTRATION_ENABLED=false
CANVAS_ALLOW_PRIVATE_UPSTREAMS=false
CANVAS_ALLOWED_PRIVATE_UPSTREAM_HOSTS=
CANVAS_CORS_ORIGINS=http://localhost:3000
CANVAS_DATA_PATH=./data
CANVAS_HTTP_PORT=3000
CANVAS_WORKER_CONCURRENCY=3
CANVAS_CHANNEL_CONCURRENCY=3
# Web/Backend 收到停止信号后先停止接单，并等待在线请求与后台任务完成；容器宽限必须更长。
CANVAS_SHUTDOWN_DRAIN_TIMEOUT=40m
CANVAS_CONTAINER_STOP_GRACE_PERIOD=45m

# 新服务器请直接运行 README 的一键部署命令；脚本会在 .env 中生成以下 PostgreSQL 配置。
# POSTGRES_DB=mingwant_studio
# POSTGRES_USER=mingwant_studio
# POSTGRES_PASSWORD=由部署脚本随机生成
# DATABASE_URL=postgresql://mingwant_studio:随机密码@postgres:5432/mingwant_studio?sslmode=disable
# REDIS_URL=redis://redis:6379/0
# CANVAS_POSTGRES_DATA_PATH=./postgres-data
# CANVAS_REDIS_DATA_PATH=./redis-data
# MINGWANT_BACKEND_IMAGE=ghcr.io/你的组织/mingwant-studio-backend:latest
# MINGWANT_WEB_IMAGE=ghcr.io/你的组织/mingwant-studio-web:latest
