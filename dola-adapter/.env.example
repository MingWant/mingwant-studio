DOLA_ADAPTER_HOST=127.0.0.1
DOLA_ADAPTER_PORT=8787
DOLA_ADAPTER_API_KEY=replace-with-a-long-random-api-key
DOLA_ADAPTER_ADMIN_KEY=replace-with-a-different-admin-key
DOLA_ADAPTER_DATA_DIR=.local/dola-adapter
DOLA_ADAPTER_PROFILE_ROOT=.local/dola-adapter/profiles
DOLA_ADAPTER_RESULT_ROOT=.local/dola-adapter/results
DOLA_ADAPTER_PUBLIC_BASE_URL=http://127.0.0.1:8787
DOLA_HOME_URL=https://www.dola.com/
DOLA_HEADLESS=false
# managed 由 Playwright 启动独立浏览器；cdp 接管你用普通 Chrome 手动登录的工作台。
DOLA_BROWSER_MODE=managed
# DOLA_BROWSER_MODE=cdp 时填写本机 Chrome 的远程调试地址；账号也可在管理台单独设置。
DOLA_BROWSER_CDP_URL=http://127.0.0.1:9222
# Google 登录被拒绝时可改用本机正式浏览器；可选 chrome 或 msedge。
DOLA_BROWSER_CHANNEL=chrome
DOLA_QUOTA_TIME_ZONE=Asia/Hong_Kong
DOLA_QUOTA_RESET_HOUR=0
DOLA_POLL_INTERVAL=15s
DOLA_ACCOUNT_LEASE=45m
DOLA_TASK_TIMEOUT=45m
DOLA_BROWSER_TIMEOUT=60s
